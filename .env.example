# GEMINI_API_KEY: Optional AI Studio runtime key (not required for RootWatch prototype demo mode).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Optional custom path for the SQLite database file (defaults to ./data/rootwatch.db).
SQLITE_DB_PATH=""

# TELEGRAM_BOT_TOKEN: Optional server-side token for future Telegram alert delivery integration.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Optional server-side target chat ID for future Telegram alerts.
TELEGRAM_CHAT_ID=""

# DEVICE_INGEST_KEY: Optional server-side shared token for ESP32 HTTP telemetry ingestion.
DEVICE_INGEST_KEY=""
